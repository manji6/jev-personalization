{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jev-personalization",
  "main": "src/cloudflare/worker.js",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "dist/assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jev-personalization-config",
      "migrations_dir": "migrations",
      "database_id": "e4fb509d-6ddc-4a45-b03a-bd3900d9a633"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MODEL_BUDGET",
        "class_name": "ModelBudget"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ModelBudget"]
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "vars": {
    "JEV_MODEL": "jev-1.14.0",
    "DAILY_REQUEST_BUDGET": "1000",
    "MAX_CONCURRENT": "10"
  },
  "observability": {
    "enabled": false
  },
  "account_id": "4dd1b5dbfb7c717db2265f63b5d38c54"
}
